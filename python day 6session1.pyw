    "from typing import List\n",
    "def find_median_sorted_arrays(nums1,nums2):\n",
    "    #Always ensure binary search runs on the smaller array for 0(log(min(m,n)))\n",
    "    if len(nums1) >len(nums2):\n",
    "        nums1,nums2 =nums2,nums1\n",
    "    m, n =len(nums1),len(nums2)\n",
    "    low,high =0,m\n",
    "    while low<=high:\n",
    "        partition_x =(low +high)//2\n",
    "        partition_y = (m+n+1)//2 -partition_x\n",
    "        # Edge cases: Agar partition extreme left/right par ho\n",
    "        max_left_x = float('-inf') if partition_x == 0 else nums1[partition_x - 1]\n",
    "        min_right_x = float('inf') if partition_x == m else nums1[partition_x]\n",
    "\n",
    "        max_left_y = float('-inf') if partition_y == 0 else nums2[partition_y - 1]\n",
    "        min_right_y = float('inf') if partition_y == n else nums2[partition_y]\n",
    "\n",
    "        # Valid Partition Condition Check\n",
    "        if max_left_x <= min_right_y and max_left_y <= min_right_x:\n",
    "            # Odd total length\n",
    "            if (m + n) % 2 != 0:\n",
    "                return float(max(max_left_x, max_left_y))\n",
    "            # Even total length\n",
    "            return (max(max_left_x, max_left_y) + min(min_right_x, min_right_y)) / 2.0\n",
    "        \n",
    "        elif max_left_x > min_right_y:\n",
    "            # Left side mein heavy elements hain, move search space to left\n",
    "            high = partition_x - 1\n",
    "        else:\n",
    "            # Left side mein kam elements hain, move search space to right\n",
    "            low = partition_x + 1\n",
    "\n",
    "    raise ValueError(\"Input arrays are not sorted properly.\")\n",
    "\n",
    "\n",
    "# --- Test Drive ---\n",
    "arr1 = [1, 3, 8, 9, 15]\n",
    "arr2 = [7, 11, 18, 19, 21, 25]\n",
    "print(f\"Median: {find_median_sorted_arrays(arr1, arr2)}\")  "
   ]
